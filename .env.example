# ==========================================
# DATABASE (Supabase PostgreSQL)
# ==========================================
# Ambil dari Supabase Dashboard -> Project Settings -> Database -> Connection string:
# Mode: Transaction (port 6543) dengan pgbouncer=true untuk DATABASE_URL
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Mode: Session (port 5432) untuk DIRECT_URL (digunakan untuk migrasi prisma)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# AUTHENTICATION (NextAuth.js)
# ==========================================
# URL aplikasi (localhost di lokal, atau https://domain-anda.vercel.app saat di Vercel)
NEXTAUTH_URL="http://localhost:3000"

# Generate string acak aman: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_key_minimum_32_characters"

# ==========================================
# ASSET STORAGE (Cloudflare R2)
# ==========================================
# Ambil dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="coursera-assets"

# Public URL dari R2 Bucket Settings -> Public Development R2.dev URL atau Custom Domain
R2_PUBLIC_DOMAIN="https://pub-yourr2id.r2.dev"

